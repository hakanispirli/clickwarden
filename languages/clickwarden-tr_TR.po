#. Plugin Name of the plugin
#: clickwarden.php
msgid "ClickWarden – Click Fraud Protection for Google Ads"
msgstr "ClickWarden – Google Ads için Tıklama Sahtekarlığı Koruması"

#. Plugin URI of the plugin
#: clickwarden.php
msgid "https://github.com/hakanispirli/clickwarden"
msgstr "https://github.com/hakanispirli/clickwarden"

#. Description of the plugin
#: clickwarden.php
msgid ""
"Detects invalid and fraudulent Google Ads clicks on your own server and "
"keeps your campaign IP exclusions up to date automatically. Free, self-"
"hosted, cache friendly."
msgstr ""
"Geçersiz ve sahte Google Ads tıklamalarını kendi sunucunuzda tespit eder ve "
"kampanyalarınızın IP hariç tutma listesini otomatik olarak güncel tutar. "
"Ücretsiz, kendi sitenizde çalışır, önbellek dostudur."

#. Author of the plugin
#: clickwarden.php
msgid "Webmarka"
msgstr "Webmarka"

#. Author URI of the plugin
#: clickwarden.php
msgid "https://webmarka.com"
msgstr "https://webmarka.com"

