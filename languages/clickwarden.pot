#. Description of the plugin
#: clickwarden.php
msgid "Detects invalid and fraudulent Google Ads clicks on your own server and keeps your campaign IP exclusions up to date automatically. Free, self-hosted, cache friendly."
msgstr ""

#. Author of the plugin
#: clickwarden.php
msgid "Webmarka"
msgstr ""

